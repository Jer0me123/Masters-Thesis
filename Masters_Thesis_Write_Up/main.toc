\contentsline {section}{\numberline {4.2}Dataset Classification}{82}{section.4.2}%
\contentsline {paragraph}{1. The three datasets are separable across every level of representation tested}{82}{table.caption.40}%
\contentsline {paragraph}{2. Dataset separability cannot be explained by acquisition artefacts alone}{83}{table.caption.40}%
\contentsline {paragraph}{3. Local spatial statistics are highly dataset-discriminative}{84}{table.caption.40}%
\contentsline {paragraph}{4. Both frequency bands carry strong discriminating signal, with a modest advantage for high-frequency components}{84}{table.caption.40}%
\contentsline {paragraph}{5. A hierarchy of dataset-discriminating signal exists across representational levels}{85}{table.caption.40}%
\contentsline {paragraph}{6. Semantic dataset differences survive compression to natural language}{85}{table.caption.40}%
\contentsline {paragraph}{7. Absolute accuracies exceed those reported in the reference framework}{86}{table.caption.40}%
\contentsline {section}{\numberline {4.3}Demographic Attribute Separability}{86}{section.4.3}%
\contentsline {subsection}{\numberline {4.3.1}Gender Artifact Analysis}{87}{subsection.4.3.1}%
\contentsline {paragraph}{Unmodified images establish a strong separability upper bound}{87}{table.caption.41}%
\contentsline {paragraph}{Occlusion probes reveal a fundamental asymmetry between datasets}{87}{table.caption.41}%
\contentsline {paragraph}{Global colour statistics carry modest but consistent signal in both datasets}{88}{table.caption.41}%
\contentsline {paragraph}{Geometric probes reveal body configuration as an independent signal source}{89}{table.caption.41}%
\contentsline {paragraph}{Semantic probes reveal scene composition and language as additional signal carriers}{89}{table.caption.41}%
\contentsline {paragraph}{The two datasets exhibit qualitatively distinct spurious gender feature profiles}{90}{table.caption.41}%
\contentsline {subsection}{\numberline {4.3.2}Skin Tone Artifact Analysis}{90}{subsection.4.3.2}%
\contentsline {paragraph}{Unmodified images establish a strong separability upper bound}{90}{table.caption.43}%
\contentsline {paragraph}{Occlusion probes reveal the same dataset asymmetry observed for gender, with per-class variation}{92}{table.caption.43}%
\contentsline {paragraph}{Global colour statistics carry weaker photometric signal than for gender}{92}{table.caption.43}%
\contentsline {paragraph}{Geometric probes produce comparable signal for skin tone and gender, with SD v1.5 showing stronger encoding}{93}{table.caption.43}%
\contentsline {paragraph}{Object detection probes show that scene composition encodes skin tone in both datasets}{93}{table.caption.43}%
\contentsline {paragraph}{Caption probing reveals a cross-dataset asymmetry absent from the visual probes}{93}{table.caption.43}%
\contentsline {paragraph}{Per-class results reveal systematic difficulty for mid-range skin tones across all probes}{94}{table.caption.43}%
\contentsline {paragraph}{Skin tone and gender exhibit analogous but not identical spurious feature profiles}{94}{table.caption.43}%
