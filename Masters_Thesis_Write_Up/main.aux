\@writefile{toc}{\contentsline {section}{\numberline {4.2}Dataset Classification}{82}{section.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{1. The three datasets are separable across every level of representation tested}{82}{table.caption.40}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4.3}{\ignorespaces Dataset classification results per image transformation (three-class: Re-LAION-5B, Stable Diffusion v1.5, COCO). All models trained with ConvNeXt-Tiny, early stopping (patience = 2), seed = 0.}}{83}{table.caption.40}\protected@file@percent }
\newlabel{tab:dataset_classification_results}{{4.3}{83}{Dataset classification results per image transformation (three-class: Re-LAION-5B, Stable Diffusion v1.5, COCO). All models trained with ConvNeXt-Tiny, early stopping (patience = 2), seed = 0}{table.caption.40}{}}
\@writefile{toc}{\contentsline {paragraph}{2. Dataset separability cannot be explained by acquisition artefacts alone}{83}{table.caption.40}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{3. Local spatial statistics are highly dataset-discriminative}{84}{table.caption.40}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{4. Both frequency bands carry strong discriminating signal, with a modest advantage for high-frequency components}{84}{table.caption.40}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{5. A hierarchy of dataset-discriminating signal exists across representational levels}{85}{table.caption.40}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{6. Semantic dataset differences survive compression to natural language}{85}{table.caption.40}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{7. Absolute accuracies exceed those reported in the reference framework}{86}{table.caption.40}\protected@file@percent }
