\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.1}Gender Artifact Analysis}{87}{subsection.4.3.1}\protected@file@percent }
\newlabel{subsec:gender_artifact_analysis}{{4.3.1}{87}{Gender Artifact Analysis}{subsection.4.3.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4.4}{\ignorespaces Gender separability results per image transformation and dataset. All probes trained with seed 0 unless otherwise noted. AUC is the primary metric; chance level is 0.500 for binary classification.}}{87}{table.caption.41}\protected@file@percent }
\newlabel{tab:gender_separability}{{4.4}{87}{Gender separability results per image transformation and dataset. All probes trained with seed 0 unless otherwise noted. AUC is the primary metric; chance level is 0.500 for binary classification}{table.caption.41}{}}
\@writefile{toc}{\contentsline {paragraph}{Unmodified images establish a strong separability upper bound}{87}{table.caption.41}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Occlusion probes reveal a fundamental asymmetry between datasets}{87}{table.caption.41}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Global colour statistics carry modest but consistent signal in both datasets}{88}{table.caption.41}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Geometric probes reveal body configuration as an independent signal source}{89}{table.caption.41}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Semantic probes reveal scene composition and language as additional signal carriers}{89}{table.caption.41}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The two datasets exhibit qualitatively distinct spurious gender feature profiles}{90}{table.caption.41}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.2}Skin Tone Artifact Analysis}{90}{subsection.4.3.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4.5}{\ignorespaces Skin tone separability results per image transformation and dataset (MST 1--8). All probes trained with seed 0 unless otherwise noted. Macro-averaged AUC is the primary metric; chance level is 0.500.}}{90}{table.caption.42}\protected@file@percent }
\newlabel{tab:skintone_separability_overall}{{4.5}{90}{Skin tone separability results per image transformation and dataset (MST 1--8). All probes trained with seed 0 unless otherwise noted. Macro-averaged AUC is the primary metric; chance level is 0.500}{table.caption.42}{}}
\@writefile{toc}{\contentsline {paragraph}{Unmodified images establish a strong separability upper bound}{90}{table.caption.43}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4.6}{\ignorespaces Per-class skin tone AUC per image transformation and dataset (MST 1--8). MST~9 and MST~10 are absent from both datasets and left blank. All probes trained with seed 0 unless otherwise noted.}}{91}{table.caption.43}\protected@file@percent }
\newlabel{tab:skintone_separability_perclass}{{4.6}{91}{Per-class skin tone AUC per image transformation and dataset (MST 1--8). MST~9 and MST~10 are absent from both datasets and left blank. All probes trained with seed 0 unless otherwise noted}{table.caption.43}{}}
\@writefile{toc}{\contentsline {paragraph}{Occlusion probes reveal the same dataset asymmetry observed for gender, with per-class variation}{92}{table.caption.43}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Global colour statistics carry weaker photometric signal than for gender}{92}{table.caption.43}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Geometric probes produce comparable signal for skin tone and gender, with SD v1.5 showing stronger encoding}{93}{table.caption.43}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Object detection probes show that scene composition encodes skin tone in both datasets}{93}{table.caption.43}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Caption probing reveals a cross-dataset asymmetry absent from the visual probes}{93}{table.caption.43}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Per-class results reveal systematic difficulty for mid-range skin tones across all probes}{94}{table.caption.43}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Skin tone and gender exhibit analogous but not identical spurious feature profiles}{94}{table.caption.43}\protected@file@percent }
