\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces Precision-recall curves at IoU$=0.5$ on the WIDER Face validation set for all four evaluated face detection models. RetinaFace and MediaPipe both exhibit a recall ceiling below 0.35 at near-perfect precision, indicating systematic detection suppression. SCRFD maintains high precision to approximately 0.6 recall before degrading. YOLOv12l-Face achieves the widest high-precision operating range, sustaining near-perfect precision to approximately 0.8 recall, consistent with its superior AP@0.5 and small-face detection performance.}}{37}{figure.caption.7}\protected@file@percent }
\newlabel{fig:face_det_pr}{{3.1}{37}{Precision-recall curves at IoU$=0.5$ on the WIDER Face validation set for all four evaluated face detection models. RetinaFace and MediaPipe both exhibit a recall ceiling below 0.35 at near-perfect precision, indicating systematic detection suppression. SCRFD maintains high precision to approximately 0.6 recall before degrading. YOLOv12l-Face achieves the widest high-precision operating range, sustaining near-perfect precision to approximately 0.8 recall, consistent with its superior AP@0.5 and small-face detection performance}{figure.caption.7}{}}
